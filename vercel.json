{
  "crons": [
    {
      "path": "/api/cron/youtube-sync",
      "schedule": "0 14,21 * * *"
    },
    {
      "path": "/api/cron/youtube-sync-longform",
      "schedule": "30 14,21 * * *"
    },
    {
      "path": "/api/cron/instagram-sync",
      "schedule": "0 11,17,23,5 * * *"
    },
    {
      "path": "/api/cron/diagnostics-alert",
      "schedule": "0 */6 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/youtube-sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/youtube-sync-longform/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/instagram-sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/youtube-sync/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/youtube-sync-longform/route.ts": {
      "maxDuration": 60
    }
  }
}
